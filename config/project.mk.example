# -----------------------------------------------------------------------------
# Project
# -----------------------------------------------------------------------------

PROJECT_NAME :=  project

# ADR repository, relative to adr-tooling repository.
ADR_REPO := ../ project-adr


# -----------------------------------------------------------------------------
# ADR repository structure
# -----------------------------------------------------------------------------

ADR_TEMPLATE := docs/adrs/ai/template.md
ADR_APPROVED := docs/adrs/ai/approved
ADR_PROPOSED := docs/adrs/ai/proposed
ADR_DIAGRAMS := docs/diagrams


# -----------------------------------------------------------------------------
# OpenCode models
# -----------------------------------------------------------------------------

MODEL_ARCHITECT := openai/gpt-6-astra
MODEL_WRITER := openai/gpt-6-sol
MODEL_REVIEWER := openai/gpt-6-astra
MODEL_FINDER := openai/gpt-6-luna-fast
MODEL_AUDITOR := openai/gpt-6-astra


# -----------------------------------------------------------------------------
# OpenCode agents
# -----------------------------------------------------------------------------

AGENT_ARCHITECT := architect
AGENT_WRITER := adr-writer
AGENT_REVIEWER := adr-reviewer
AGENT_FINDER := architecture-finder
AGENT_AUDITOR := consistency-auditor


# -----------------------------------------------------------------------------
# Optional Langfuse integration
# -----------------------------------------------------------------------------

LANGFUSE_ENABLED := 0
LANGFUSE_BASE_URL := http://localhost:3000
LANGFUSE_PROMPT_LABEL := production

LANGFUSE_PROMPT_ARCHITECT := adr/architect
LANGFUSE_PROMPT_WRITER := adr/adr-writer
LANGFUSE_PROMPT_REVIEWER := adr/adr-reviewer
LANGFUSE_PROMPT_FINDER := adr/architecture-finder
LANGFUSE_PROMPT_AUDITOR := adr/consistency-auditor

# Empty = latest
LANGFUSE_VERSION_ARCHITECT :=
LANGFUSE_VERSION_WRITER :=
LANGFUSE_VERSION_REVIEWER :=
LANGFUSE_VERSION_FINDER :=
LANGFUSE_VERSION_AUDITOR :=